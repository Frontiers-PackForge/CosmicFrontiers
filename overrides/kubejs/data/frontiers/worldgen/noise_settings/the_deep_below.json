                "type": "minecraft:y_clamped_gradient",
                "from_value": -1.0,
                "from_y": 0,
                "to_value": 1.0,
                "to_y": 96
              }
            },
            "argument2": {
              "type": "minecraft:mul",
              "argument1": 0.28,
              "argument2": {
                "type": "minecraft:y_clamped_gradient",
                "from_value": 1.0,
                "from_y": 416,
                "to_value": -1.0,
                "to_y": 512
              }
            }
          }
        },
        "argument2": -0.60
